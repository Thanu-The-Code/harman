# Copy this file to .env. Never commit real credentials.
#
# Deployment-specific values live here.
#
# Precedence (lowest -> highest):
#   code defaults  <  config/models.json  <  this .env  <  database settings table
# After editing config/models.json on an existing install, run:
#   python cli.py sync-model-config

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SECRET_KEY=
JWT_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=production
# Sign-in is required. Set false only for local API development, never on a server people use.
AUTHENTICATION_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
TRUSTED_PROXY_IPS=127.0.0.1,::1

# ---------------------------------------------------------------------------
# Database and storage
# ---------------------------------------------------------------------------
# PostgreSQL is the default backend for local and production deployments.
# Override these values or set a direct DATABASE_URL when your environment
# differs from the defaults below.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=paperless_factory
DATABASE_USER=postgres
DATABASE_PASSWORD=
# Optional: set DATABASE_URL instead of the individual DATABASE_* values.
DATABASE_URL=
DATA_FOLDER=./data
STAGING_FOLDER=./data/staging
STORAGE_FOLDER=./data/storage
LOGS_FOLDER=./data/logs
BACKUP_FOLDER=./data/backups

# ---------------------------------------------------------------------------
# File handling
# ---------------------------------------------------------------------------
MAX_FILE_SIZE=100MB
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff,bmp,txt,text,md,markdown

# ---------------------------------------------------------------------------
# Runtime behaviour
# ---------------------------------------------------------------------------
# Model overrides stay commented so config/models.json remains the source of
# truth for deployment-specific OCR and PDF settings.
# OCR_ENGINE=auto
# PDF_TEXT_LAYER_FIRST=false
# PADDLE_ENABLED=true
# PADDLE_TABLE=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Mail, for the record process trigger notifications
#
# The record filling & approval process asks for a notification at six points:
# to the Process Owner when a record is filled and needs approval; to the
# Overall Process Owner when the Process Owner has approved, and again the
# moment an N-ok observation is flagged; to every CFT member when a joint
# review opens, and when a record comes back for re-verification; and to the
# QMS Coordinator when a change request is raised.
#
# Every one of those is written to the `notifications` table BEFORE any attempt
# to send, so the trail is complete and auditable whether or not a mail server
# is reachable. With SMTP_HOST unset the notifications are recorded and marked
# "skipped" rather than "failed" - the process still runs, and people see the
# same triggers in the product's own notification list.
#
# Leave SMTP_HOST empty to run without email.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
SMTP_FROM_NAME=Paperless Factory
SMTP_TIMEOUT=20





# Copy every trigger to one address, if the site wants a single place to watch
# the process from. Optional.
NOTIFICATIONS_COPY_TO=

# Where the links inside those emails point. Set this to the address people
# actually reach the system on, or every link in every notification is wrong.
APP_BASE_URL=http://127.0.0.1:8000
